# Copy to .env and fill in.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# TESTING PHASE ONLY.
# Disables the ID check-digit test and every password rule, so accounts like
# 12345678 / "12345678" work while the apps are being built.
# Must be False in production -- `manage.py check --deploy` refuses to pass otherwise.
RELAXED_AUTH=True

# Postgres. DATABASE_URL takes priority over the DB_* pair below.
# On Railway, add a Postgres service and set this as a reference variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://user:password@host:5432/alomforce

# DB_ENGINE=postgres
# DB_NAME=alomforce
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Catalog data sources (JSON rows). Each manufacturer in core/data/manufacturers.json
# imports from its bundled file unless CATALOG_URL_<SLUG> (e.g. CATALOG_URL_EXTAL)
# points at a hosted copy. CATALOG_URL is the default manufacturer's (Klil).
CATALOG_URL=https://res.cloudinary.com/<cloud_name>/raw/upload/catalog/klil_catalog_rows.json

# Crash reporting for the desktop and phone apps. A second Sentry project's DSN,
# handed to the apps through /api/config/ so one variable turns it on for every
# installed copy. SENTRY_DSN (backend) and this one are usually two projects.
# SENTRY_DSN_CLIENTS=
